 arch/powerpc/platforms/powernv/npu-dev.c  |  73 +++
 arch/powerpc/platforms/powernv/npu-lpar.c | 110 +++++
 arch/powerpc/platforms/powernv/npu-main.c | 144 ++++++
 arch/powerpc/platforms/powernv/npu.h      |  52 ++
 7 files changed, 945 insertions(+)
 create mode 100644 arch/powerpc/platforms/powernv/npu-ats.c
 create mode 100644 arch/powerpc/platforms/powernv/npu-dev.c
 create mode 100644 arch/powerpc/platforms/powernv/npu-lpar.c
 create mode 100644 arch/powerpc/platforms/powernv/npu-main.c
 create mode 100644 arch/powerpc/platforms/powernv/npu.h

